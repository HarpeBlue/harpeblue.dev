---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactCta from "../../components/ContactCta.astro";
import Experience from "../../components/Experience.astro";
import Hero from "../../components/Hero.astro";
import Projects from "../../components/Projects.astro";
import SiteNav from "../../components/SiteNav.astro";
import Skills from "../../components/Skills.astro";
import { content } from "../../data";

const page = content.es;
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  lang={page.locale}
  path={page.path}
  ogLocale={page.seo.ogLocale}
  socialImageAlt={page.seo.socialImageAlt}
  skipLink={page.skipLink}
>
  <SiteNav content={page} />
  <main id="main-content" class="page-shell page-flow" tabindex="-1">
    <Hero content={page} />
    <Experience content={page} />
    <Projects content={page} />
    <Skills content={page} />
    <ContactCta content={page} />
  </main>
</BaseLayout>
