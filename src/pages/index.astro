---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data";

const title = `${profile.name} - ${profile.role}`;
---

<BaseLayout title={title} description={profile.summary}>
  <main>
    <p>{profile.alias}</p>
    <h1>{profile.name}</h1>
    <p>{profile.headline}</p>
  </main>
</BaseLayout>
