---
import type { PageContent } from "../data/content/index";

type Props = {
  content: PageContent;
};

const { content } = Astro.props;
const experience = content.experience;
---

<section id="experience" class="hb-theme hb-theme--liquid-signal portfolio-section experience" aria-labelledby="experience-title">
  <div class="hb-hero">
    <p class="hb-eyebrow">{experience.eyebrow}</p>
    <h2 id="experience-title" class="portfolio-section-title">{experience.title}</h2>
    <p class="hb-copy">{experience.description}</p>
  </div>

  <div class="hb-grid">
    {
      experience.items.map((job) => (
        <article class="hb-card hb-card--accent hb-stack">
          <header class="experience-card__header">
            <div>
              <h3 translate="no">{job.company}</h3>
              <p class="experience-card__role">{job.role}</p>
            </div>
            <p class="experience-card__meta">
              {job.startDate} - {job.endDate}
              <br />
              {job.location}
            </p>
          </header>

          <p>{job.summary}</p>

          <ul class="experience-card__highlights">
            {job.highlights.map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ul>

          <div class="hb-row" aria-label={`${job.company} ${experience.technologiesLabel}`}>
            {job.technologies.map((technology) => (
              <span class="hb-badge">{technology}</span>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .experience-card__header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hb-space-4);
    justify-content: space-between;
  }

  .experience-card__role,
  .experience-card__meta {
    margin: 0;
    color: var(--hb-muted);
  }

  .experience-card__meta {
    font-size: 0.9rem;
    text-align: left;
  }

  .experience-card__highlights {
    display: grid;
    gap: var(--hb-space-3);
    margin: 0;
    padding-left: 1.2rem;
    color: var(--hb-muted);
  }

  .experience-card__highlights li::marker {
    color: var(--hb-secondary);
  }

  @media (min-width: 42rem) {
    .experience-card__meta {
      text-align: right;
    }
  }
</style>
