---
import type { PageContent } from "../data/content/index";

type Props = {
  content: PageContent;
};

const { content } = Astro.props;
const { profile, hero } = content;
---

<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="hero__index" aria-hidden="true">
    <span>01</span>
    <span>PROFILE / PRODUCT UI</span>
  </div>

  <div class="hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-title" class="hero__title" translate="no">{profile.name}</h1>
      <p class="hero__headline">{profile.headline}</p>
      <p class="hero__intro">{hero.intro}</p>
      <p class="hero__summary">{profile.summary}</p>

      <nav class="actions hero__actions" aria-label={hero.linksLabel}>
        <a class="action action--primary action--internal" href="#projects">{hero.work}</a>
        <a class="action action--internal" href="#contact">{hero.contact}</a>
        <a class="action" href={profile.links.resume}>{hero.resume}</a>
      </nav>

      <p class="meta-line hero__meta">
        <span>{profile.availability}</span>
        <span>{profile.location}</span>
      </p>
    </div>

    <aside class="hero__proof" aria-label={hero.proofLabel}>
      <p class="hero__proof-label">{hero.proofLabel}</p>
      <ol class="hero__proof-list">
        {
          hero.proofs.map((proof, index) => (
            <li>
              <span class="hero__proof-index" aria-hidden="true">0{index + 1}</span>
              <strong>{proof.value}</strong>
              <span>{proof.label}</span>
            </li>
          ))
        }
      </ol>
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: min(54rem, calc(100svh - 4.5rem));
    align-content: center;
    padding-block: clamp(4.5rem, 10vw, 8rem);
    scroll-margin-top: 7rem;
  }

  .hero::before {
    position: absolute;
    z-index: -1;
    top: 18%;
    right: -12vw;
    width: min(48rem, 82vw);
    aspect-ratio: 1;
    background: radial-gradient(circle, rgb(55 120 255 / 16%), transparent 66%);
    content: "";
    pointer-events: none;
  }

  .hero__index {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    color: var(--muted);
    font: 700 0.68rem/1 var(--font-mono);
    letter-spacing: 0.12em;
  }

  .hero__index span:first-child {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    color: var(--canvas);
    background: var(--blue);
    border-radius: 50%;
    letter-spacing: 0;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.37fr);
    gap: clamp(3rem, 9vw, 8rem);
    align-items: end;
  }

  .hero__copy {
    min-width: 0;
  }

  .hero__title {
    max-width: 8ch;
    margin: 1.3rem 0 1.7rem;
    color: var(--text);
    font-size: clamp(4.3rem, 10.5vw, 9.4rem);
    font-weight: 900;
    letter-spacing: -0.085em;
    line-height: 0.78;
  }

  .hero__title::first-line {
    color: var(--blue);
  }

  .hero__headline {
    max-width: 18ch;
    margin: 0 0 1.2rem;
    color: var(--text);
    font-size: clamp(1.8rem, 4.8vw, 4.1rem);
    font-weight: 820;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .hero__intro {
    max-width: 47ch;
    margin: 0 0 0.7rem;
    color: var(--cyan);
    font: 650 clamp(0.88rem, 1.5vw, 1rem) / 1.6 var(--font-mono);
  }

  .hero__summary {
    max-width: 64ch;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.65vw, 1.18rem);
  }

  .hero__actions {
    margin-top: 2rem;
  }

  .hero__meta {
    margin-top: 1.4rem;
  }

  .hero__proof {
    position: relative;
    padding: 1.25rem 0 0 1.25rem;
    border-top: 1px solid var(--line-strong);
    border-left: 1px solid var(--line-strong);
  }

  .hero__proof::before {
    position: absolute;
    top: -0.25rem;
    left: -0.25rem;
    width: 0.45rem;
    height: 0.45rem;
    background: var(--cyan);
    border-radius: 50%;
    box-shadow: 0 0 1.2rem var(--cyan);
    content: "";
  }

  .hero__proof-label {
    margin: 0 0 1.3rem;
    color: var(--muted);
    font: 750 0.68rem/1 var(--font-mono);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .hero__proof-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__proof-list li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.15rem 0.8rem;
    padding-block: 1.05rem;
    border-top: 1px solid var(--line);
  }

  .hero__proof-index {
    grid-row: 1 / 3;
    color: var(--blue);
    font: 700 0.65rem/1.5 var(--font-mono);
  }

  .hero__proof-list strong {
    color: var(--text);
    font-size: clamp(1.55rem, 3vw, 2.25rem);
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .hero__proof-list li > span:last-child {
    color: var(--muted);
    font-size: 0.88rem;
  }

  @media (max-width: 54rem) {
    .hero {
      min-height: auto;
    }

    .hero__grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .hero__proof {
      display: grid;
      grid-template-columns: 9rem 1fr;
      gap: 1rem;
    }

    .hero__proof-label {
      margin: 1.1rem 0 0;
    }

    .hero__proof-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .hero__proof-list li {
      grid-template-columns: 1fr;
      align-content: start;
      padding-inline: 0.85rem;
      border-left: 1px solid var(--line);
    }

    .hero__proof-index {
      grid-row: auto;
    }
  }

  @media (max-width: 42rem) {
    .hero {
      padding-block: 3.75rem 5rem;
      scroll-margin-top: 10rem;
    }

    .hero__index {
      margin-bottom: 2rem;
    }

    .hero__title {
      margin-block: 1.2rem 1.35rem;
      font-size: clamp(4rem, 22vw, 6rem);
      line-height: 0.82;
    }

    .hero__headline {
      font-size: clamp(1.8rem, 10vw, 2.7rem);
    }

    .hero__proof {
      grid-template-columns: 1fr;
      padding-inline-start: 1rem;
    }

    .hero__proof-label {
      margin-top: 0;
    }

    .hero__proof-list {
      grid-template-columns: 1fr;
    }

    .hero__proof-list li {
      grid-template-columns: 2rem minmax(0, 1fr);
      padding-inline: 0;
      border-left: 0;
    }

    .hero__proof-index {
      grid-row: 1 / 3;
    }
  }
</style>
