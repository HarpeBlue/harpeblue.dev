---
import type { PageContent } from "../data/content/index";

type Props = {
  content: PageContent;
};

const { content } = Astro.props;
const { profile } = content;
---

<section id="contact" class="hb-theme hb-theme--rave-mode portfolio-section contact-cta" aria-labelledby="contact-title">
  <div class="hb-hero contact-cta__content">
    <div class="hb-stack">
      <p class="hb-eyebrow">{content.contact.eyebrow}</p>
      <h2 id="contact-title" class="portfolio-section-title contact-cta__title">{content.contact.title}</h2>
      <p class="hb-copy">{content.contact.description}</p>
    </div>

    <nav class="hb-row" aria-label={content.contact.linksLabel}>
      <a class="hb-button hb-button--secondary" href={profile.links.resume}>{content.contact.resume}</a>
      <a class="hb-button hb-button--secondary" href={profile.links.email}>{content.contact.email}</a>
      <a class="hb-button hb-button--secondary" href={profile.links.linkedin}>LinkedIn</a>
      <a class="hb-button hb-button--secondary" href={profile.links.github}>GitHub</a>
    </nav>
  </div>
</section>

<style>
  .contact-cta__content {
    gap: var(--hb-space-8);
  }

  .contact-cta__title {
    max-width: 16ch;
  }
</style>
