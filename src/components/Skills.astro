---
import type { PageContent } from "../data/content/index";

type Props = {
  content: PageContent;
};

const { content } = Astro.props;
const skills = content.skills;
---

<section class="hb-theme hb-theme--liquid-signal portfolio-section skills" aria-labelledby="skills-title">
  <div class="hb-hero">
    <p class="hb-eyebrow">{skills.eyebrow}</p>
    <h2 id="skills-title" class="portfolio-section-title">{skills.title}</h2>
    <p class="hb-copy">{skills.description}</p>
  </div>

  <div class="hb-grid">
    {
      skills.groups.map((group) => (
        <article class="hb-card hb-stack">
          <h3>{group.category}</h3>
          <div class="hb-row" aria-label={`${group.category} skills`}>
            {group.items.map((skill) => (
              <span class="hb-badge">{skill}</span>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>
