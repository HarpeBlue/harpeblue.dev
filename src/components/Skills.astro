---
import { skills } from "../data";
---

<section class="hb-theme hb-theme--fresh-utility skills" aria-labelledby="skills-title">
  <div class="hb-hero">
    <p class="hb-eyebrow">Skills</p>
    <h2 id="skills-title" class="hb-title">Frontend capabilities</h2>
    <p class="hb-copy">
      Technologies and practices grouped by how they show up in real frontend work:
      product UI, data flows, testing, tooling, and systems.
    </p>
  </div>

  <div class="hb-grid">
    {
      skills.map((group) => (
        <article class="hb-card hb-stack">
          <h3>{group.category}</h3>
          <div class="hb-row" aria-label={`${group.category} skills`}>
            {group.items.map((skill) => (
              <span class="hb-badge">{skill}</span>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .skills {
    display: grid;
    gap: var(--hb-space-8);
    margin-block: var(--hb-space-12);
  }
</style>
