---
import type { PageContent } from "../data/content/index";

type Props = {
  content: PageContent;
};

const { content } = Astro.props;
const projects = content.projects;
---

<section id="projects" class="section projects" aria-labelledby="projects-title">
  <header class="section-heading">
    <p class="eyebrow">03 / {projects.eyebrow}</p>
    <h2 id="projects-title" class="section-title">{projects.title}</h2>
    <p class="section-copy">{projects.description}</p>
  </header>

  <div class="projects__grid">
    {
      projects.items.map((project, index) => (
        <article class:list={["project", { "project--featured": index === 0 }]}>
          <header class="project__header">
            <p class="project__index" aria-hidden="true">PROJECT / 0{index + 1}</p>
            <p class="project__status"><span aria-hidden="true" />{project.status}</p>
          </header>

          <div class="project__body">
            <div class="project__intro">
              <h3 translate="no">{project.name}</h3>
              <p>{project.description}</p>
            </div>

            <ul class="project__highlights">
              {project.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
          </div>

          <div class="project__footer">
            <ul class="tag-list" aria-label={`${project.name} ${projects.technologiesLabel}`}>
              {project.technologies.map((technology) => <li class="tag" translate="no">{technology}</li>)}
            </ul>

            <nav class="actions project__actions" aria-label={`${project.name} ${projects.linksLabel}`}>
              <a class="action" href={project.repositoryUrl}>{projects.repository}</a>
              <a class="action action--primary" href={project.demoUrl}>{projects.demo}</a>
            </nav>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .projects__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .project {
    --project-accent: var(--cyan);
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 31rem;
    grid-template-rows: auto 1fr auto;
    gap: 2rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    overflow: hidden;
    background:
      linear-gradient(150deg, color-mix(in srgb, var(--project-accent) 8%, transparent), transparent 52%),
      var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .project::before {
    position: absolute;
    top: 0;
    left: clamp(1.25rem, 3vw, 2rem);
    width: 4rem;
    height: 2px;
    background: var(--project-accent);
    box-shadow: 0 0 1.5rem var(--project-accent);
    content: "";
  }

  .project:nth-child(3) {
    --project-accent: var(--blue);
  }

  .project--featured {
    --project-accent: var(--blue);
    min-height: 34rem;
    grid-column: 1 / -1;
    background:
      radial-gradient(circle at 82% 14%, rgb(72 234 213 / 13%), transparent 23rem),
      linear-gradient(135deg, rgb(55 120 255 / 23%), transparent 48%),
      var(--surface);
    border-color: var(--line-strong);
  }

  .project__header,
  .project__footer {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }

  .project__index,
  .project__status {
    margin: 0;
    font: 700 0.68rem/1.3 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project__index {
    color: var(--muted);
  }

  .project__status {
    display: inline-flex;
    gap: 0.55rem;
    align-items: center;
    color: var(--text-soft);
  }

  .project__status span {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--project-accent);
    border-radius: 50%;
    box-shadow: 0 0 0.8rem var(--project-accent);
  }

  .project__body {
    display: grid;
    gap: 2rem;
    align-content: start;
  }

  .project--featured .project__body {
    grid-template-columns: minmax(0, 1.1fr) minmax(17rem, 0.75fr);
    gap: clamp(2rem, 7vw, 6rem);
    align-items: end;
  }

  .project__intro h3 {
    max-width: 12ch;
    margin: 0 0 1.1rem;
    color: var(--text);
    font-size: clamp(2rem, 5vw, 4rem);
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .project--featured .project__intro h3 {
    font-size: clamp(3.4rem, 9vw, 7rem);
  }

  .project__intro p {
    max-width: 60ch;
    margin: 0;
    color: var(--muted);
  }

  .project__highlights {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project__highlights li {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 0.65rem;
    color: var(--text-soft);
    font-size: 0.94rem;
  }

  .project__highlights li::before {
    color: var(--project-accent);
    content: "+";
    font-family: var(--font-mono);
    font-weight: 800;
  }

  .project__footer {
    align-items: end;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .project__footer .tag-list {
    flex: 1 1 18rem;
  }

  .project__actions {
    flex: 0 1 auto;
  }

  @media (max-width: 52rem) {
    .projects__grid {
      grid-template-columns: 1fr;
    }

    .project--featured {
      grid-column: auto;
    }

    .project--featured .project__body {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 36rem) {
    .project {
      min-height: auto;
    }

    .project__footer {
      align-items: stretch;
    }

    .project__actions {
      width: 100%;
    }
  }
</style>
