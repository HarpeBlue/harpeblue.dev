---
import type { PageContent } from "../data/content/index";

type Props = {
  content: PageContent;
};

const { content } = Astro.props;
const projects = content.projects;
---

<section class="hb-theme hb-theme--terminal-lab portfolio-section projects" aria-labelledby="projects-title">
  <div class="hb-hero">
    <p class="hb-eyebrow">{projects.eyebrow}</p>
    <h2 id="projects-title" class="portfolio-section-title">{projects.title}</h2>
    <p class="hb-copy">{projects.description}</p>
  </div>

  <div class="hb-grid">
    {
      projects.items.map((project) => (
        <article class="hb-card hb-card--accent hb-stack project-card">
          <header class="project-card__header">
            <div>
              <p class="hb-badge">{project.status}</p>
              <h3>{project.name}</h3>
            </div>
          </header>

          <p>{project.description}</p>

          <ul class="project-card__highlights">
            {project.highlights.map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ul>

          <div class="hb-row" aria-label={`${project.name} ${projects.technologiesLabel}`}>
            {project.technologies.map((technology) => (
              <span class="hb-badge">{technology}</span>
            ))}
          </div>

          <nav class="hb-row" aria-label={`${project.name} ${projects.linksLabel}`}>
            <a class="hb-button hb-button--secondary" href={project.repositoryUrl}>{projects.repository}</a>
            <a class="hb-button hb-button--secondary" href={project.demoUrl}>{projects.demo}</a>
          </nav>
        </article>
      ))
    }
  </div>
</section>

<style>
  .project-card {
    align-content: start;
  }

  .project-card__header {
    display: flex;
    justify-content: space-between;
    gap: var(--hb-space-4);
  }

  .project-card__highlights {
    display: grid;
    gap: var(--hb-space-3);
    margin: 0;
    padding-left: 1.2rem;
    color: var(--hb-muted);
  }

  .project-card__highlights li::marker {
    color: var(--hb-secondary);
  }
</style>
